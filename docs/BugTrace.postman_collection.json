{
  "info": {
    "name": "BugTrace API",
    "description": "REST collection for the BugTrace Smart Error Log Analyzer. Set {{baseUrl}} to the Spring Boot server (default http://localhost:8080). No authentication is used.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "uploadId", "value": "1" },
    { "key": "incidentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload a log file",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "sample-logs/sample-app.log",
                  "description": "A real .log or .txt file, maximum 10 MB"
                }
              ]
            },
            "url": "{{baseUrl}}/api/uploads",
            "description": "201 created, 400 empty/binary, 413 too large, 415 wrong extension/content type."
          }
        },
        {
          "name": "List upload history",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/uploads?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get upload details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/uploads/{{uploadId}}"
          }
        }
      ]
    },
    {
      "name": "Incidents",
      "item": [
        {
          "name": "List / search / filter incidents",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/incidents?q=connection&severity=ERROR&status=OPEN&tag=database&from=2026-11-01&to=2026-11-30&sort=count&page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "incidents"],
              "query": [
                { "key": "q", "value": "connection" },
                { "key": "severity", "value": "ERROR" },
                { "key": "status", "value": "OPEN" },
                { "key": "tag", "value": "database" },
                { "key": "from", "value": "2026-11-01" },
                { "key": "to", "value": "2026-11-30" },
                { "key": "sort", "value": "count" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "20" }
              ]
            },
            "description": "All query parameters are optional. sort=latest|count. tag matches a lowercase incident tag."
          }
        },
        {
          "name": "List distinct tags",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidents/tags",
            "description": "Returns a plain JSON array of tags used by the filter and tag editor."
          }
        },
        {
          "name": "Export filtered incidents as CSV",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidents/export?severity=ERROR&sort=count",
            "description": "Same filters as the list endpoint. Capped at 5000 rows; X-Exported-Rows and X-Export-Truncated report the result."
          }
        },
        {
          "name": "Get incident details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}"
          }
        },
        {
          "name": "Get underlying log entries",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/entries?page=0&size=20"
          }
        },
        {
          "name": "Update incident status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"INVESTIGATING\"\n}"
            },
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/status"
          }
        },
        {
          "name": "Snooze incident",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hours\": 24\n}"
            },
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/snooze",
            "description": "Mutes the incident for 1-720 hours. Resolved incidents cannot be snoozed."
          }
        },
        {
          "name": "Wake snoozed incident",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/snooze"
          }
        },
        {
          "name": "Bulk update status",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [1, 2, 3],\n  \"status\": \"RESOLVED\"\n}"
            },
            "url": "{{baseUrl}}/api/incidents/bulk-status",
            "description": "All-or-nothing for up to 100 ids. updated counts only incidents whose status actually changed."
          }
        },
        {
          "name": "Replace incident tags",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tags\": [\"database\", \"payment\"]\n}"
            },
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/tags",
            "description": "Replaces the complete set. Send [] to clear; max 10 tags of a-z, 0-9, - or _."
          }
        },
        {
          "name": "Add investigation note",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteText\": \"Checked the connection pool size.\"\n}"
            },
            "url": "{{baseUrl}}/api/incidents/{{incidentId}}/notes"
          }
        }
      ]
    },
    {
      "name": "Log entries",
      "item": [
        {
          "name": "Search raw log entries",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/entries?q=&severity=&serviceName=&uploadId=&incidentId=&from=&to=&sort=latest&page=0&size=20",
            "description": "Matches message, raw line, service and logger (case-insensitive), including INFO/DEBUG lines that never became incidents. sort=latest|oldest|line, size max 100."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get dashboard stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard/stats?days=14",
            "description": "days is clamped to 1-90. Range values cover incidentsInRange, resolvedInRange, mttrMinutes and errorsOverTime; all-time totals are unchanged."
          }
        }
      ]
    }
  ]
}
